---
import resume from "../resume.json";
---

<div class="flex gap-2 justify-center items-center">
    {
        resume.basics.location && (
            <>
                <span class="font-pt-sans">{`${resume.basics.location.city}, ${resume.basics.location.country}`}</span>
                <p>|</p>
            </>
        )
    }

    {
        resume.basics.email && (
            <a
                href={`mailto:${resume.basics.email}`}
                class="font-pt-sans hover:underline"
                target="_blank"
                rel="noopener noreferrer"
            >
                {resume.basics.email}
            </a>
        )
    }

    {
        resume.basics.profiles.map((profile) => (
            <>
                <p>|</p>
                <a
                    href={profile.url}
                    class="font-pt-sans hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {profile.network}
                </a>
            </>
        ))
    }
</div>
