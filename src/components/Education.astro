---
import resume from "../resume.json";
---

<section>
    <h2 class="text-center mt-4 font-volkhov text-lg">Educación</h2>
    <hr />
    <div class="mt-2 font-pt-sans flex flex-col gap-2">
        {
            resume.education.map((edu) => (
                <div>
                    <div class="flex justify-between">
                        <h3 class="text-lg text-gray-500">{edu.institution}</h3>
                        <p>
                            {edu.startDate} - {edu.endDate}
                        </p>
                    </div>
                    <p>{edu.area}</p>
                </div>
            ))
        }
    </div>
</section>
