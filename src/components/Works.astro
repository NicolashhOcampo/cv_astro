---
import resume from "../resume.json";
---

<section>
    <h2 class="text-center mt-4 font-volkhov text-xl">Experiencia Laboral</h2>
    <hr />
    <div class="mt-2 font-pt-sans flex flex-col gap-2">
        {
            resume.work.map((w) => (
                <div>
                    <div class="flex justify-between">
                        <h3 class="text-xl text-gray-500">{w.name}</h3>
                        <p>
                            {w.startDate} - {w.endDate}
                        </p>
                    </div>
                    <p>{w.summary}</p>
                    <ul class="mt-2 list-disc pl-5 space-y-1 text-gray-700 marker:text-gray-500">
                        {w.highlights.map((highlight) => (
                            <li class="leading-relaxed">{highlight}</li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
</section>
